# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA deve ser commitado no Git (já está no .gitignore).

# Credenciais MyWork
MYWORK_USUARIO=marcello@grupom7x.com.br
MYWORK_SENHA=

# Caminho para o arquivo de credenciais OAuth do Google (Gmail + Drive/Sheets)
# Baixado do Google Cloud Console, formato client_secret_XXXX.json
GOOGLE_CREDENTIALS_PATH=credentials.json

# ID da planilha-modelo de banco de horas (pegar da URL da planilha no Drive)
BANCO_HORAS_TEMPLATE_ID=
